{erl_opts, [debug_info, {d, 'DEBUG'}]}.

{deps, [
    {slice, {git, "https://github.com/erlangsters/slice.git", {branch, "master"}}},
    {worker, {git, "https://github.com/erlangsters/worker.git", {branch, "master"}}},
    {egl, {git, "https://github.com/erlangsters/egl-1.5.git", {branch, "master"}}},
    {gl, {git, "https://github.com/erlangsters/opengl-4.6.git", {branch, "master"}}},
    {glfw, {git, "https://github.com/erlangsters/glfw.git", {branch, "master"}}}
]}.

{profiles, [
    {docs, [
        {plugins, [rebar3_ex_doc]},
        {ex_doc, [
            {main, "README.md"},
            {extras, [
                "README.md",
                "docs/going-2d.md",
                "docs/going-3d.md",
                "docs/texturing.md",
                "docs/graphical-resources.md",
                "docs/going-native.md",
                "docs/display-window.md",
                "docs/fancy-shapes.md",
                "docs/text-rendering.md"
            ]},
            {groups_for_extras, [
                {<<"Guides">>, [
                    <<"docs/going-2d.md">>,
                    <<"docs/going-3d.md">>,
                    <<"docs/texturing.md">>,
                    <<"docs/graphical-resources.md">>,
                    <<"docs/going-native.md">>
                ]},
                {<<"Companions">>, [
                    <<"docs/display-window.md">>,
                    <<"docs/fancy-shapes.md">>,
                    <<"docs/text-rendering.md">>
                ]}
            ]},
            {source_url, "https://github.com/erlangsters/beam-graphics"}
        ]}
    ]}
]}.
