{application, beam_graphics, [
    {description, "The missing graphics library of the BEAM ecosystem."},
    {vsn, "0.1.0"},
    {registered, []},
    {applications, [
        kernel,
        stdlib
    ]},
    {env, []},
    {modules, [
        graphics,
        graphics_vector2, graphics_vector3,
        graphics_matrix3, graphics_matrix4,
        graphics_box2, graphics_box3,
        graphics_transform2, graphics_transform3,
        graphics_view2, graphics_view3,
        graphics_color,
        graphics_context,
        graphics_mesh2, graphics_mesh3,
        graphics_texture,
        graphics_program,
        graphics_default_program,
        graphics_shape2, graphics_shape3,
        graphics_sprite,
        graphics_camera2, graphics_camera3,
        graphics_surface,
        graphics_frame
    ]},
    {licenses, ["MIT"]},
    {links, []}
 ]}.
