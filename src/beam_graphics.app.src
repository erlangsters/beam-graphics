{application, beam_graphics, [
    {description, "The missing graphics library of the BEAM ecosystem."},
    {vsn, "0.1.0"},
    {registered, []},
    {applications, [
        kernel,
        stdlib
    ]},
    {env, []},
    {modules, [
        graphics,
        vector2, vector3,
        matrix3, matrix4,
        box2, box3,
        transform2, transform3,
        view2, view3,
        color,
        graphics_context,
        vertex2, vertex3,
        mesh2, mesh3,
        texture,
        program,
        shape2, shape3,
        camera2, camera3,
        surface,
        frame
    ]},
    {licenses, ["MIT"]},
    {links, []}
 ]}.
